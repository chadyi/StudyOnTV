<?xml version="1.0" encoding="utf-8"?>
<!--
  带电视桌面的包（Gradle buildType = desktop）才声明这两个组件。

  单独拆出来是因为不少电视的应用商店 / 安装器会拒绝「声明了 HOME 入口」的包，
  默认发的包不带桌面；需要桌面的人从 GitHub Release 下载 desktop 包。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>

        <!-- alias 默认禁用，家长在面板里打开后 DesktopMode 才启用它。
             关掉只是把 alias 禁回去，不会卸载、也不会重启进程；HomeActivity 起不来自动退回系统桌面。 -->
        <activity
            android:name=".HomeActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <activity-alias
            android:name=".HomeAlias"
            android:banner="@drawable/ic_banner"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

    </application>
</manifest>
